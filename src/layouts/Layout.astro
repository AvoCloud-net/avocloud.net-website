---
import '@/styles/global.css';

interface Props {
  title?: string;
  description?: string;
  canonical?: string;
  /** Skip the org/website/webpage/FAQ JSON-LD graph — only the homepage needs it. */
  schema?: boolean;
  /** Arm the load intro. Only pass this from a page that actually renders
      <Intro> — see the head script below for why. */
  intro?: boolean;
  noindex?: boolean;
}

// Defaults reproduce the previous hardcoded homepage values exactly.
const {
  title = 'Avocloud.net — Open-Source Discord Bots, Minecraft Plugins & Web Tools',
  description = 'Avocloud.net — open-source developer group from Austria & Germany. We build Discord bots (Baxi), Minecraft plugins (AvoFilter), an open Craft Attack community server, EduGrade, QrGate, PWGEN, and more. Free, MIT-licensed.',
  canonical = 'https://avocloud.net/',
  schema: includeSchema = true,
  noindex = false,
  intro = false,
} = Astro.props;

const schema = {
  '@context': 'https://schema.org',
  '@graph': [
    {
      '@type': 'Organization',
      '@id': 'https://avocloud.net/#org',
      name: 'Avocloud.net',
      alternateName: 'Avocloud',
      url: 'https://avocloud.net/',
      logo: 'https://avocloud.net/assets/images/logo.png',
      image: 'https://avocloud.net/assets/images/logo.png',
      foundingDate: '2024',
      description:
        'Open-source software development group from Austria and Germany. Builds Discord bots, Minecraft plugins, web utilities, and operates an open Craft Attack community Minecraft server.',
      areaServed: ['AT', 'DE', 'Worldwide'],
      knowsAbout: [
        'Discord bot development', 'Minecraft plugin development', 'Open source software',
        'Web development', 'Server hosting', 'AES-256 encryption',
      ],
      sameAs: ['https://github.com/AvoCloud-net', 'https://avocloud.net/discord/', 'https://avolink.net/'],
      owns: [
        {
          '@type': 'WebSite',
          '@id': 'https://avolink.net/#website',
          url: 'https://avolink.net/',
          name: 'AvoLink',
          alternateName: ['AvoLink.net', 'Avo Link'],
          description:
            'Free link shortener and Linktree alternative by Avocloud.net. Create short branded URLs and a single profile page for all your social links.',
          inLanguage: ['en', 'de'],
          publisher: { '@id': 'https://avocloud.net/#org' },
        },
      ],
      contactPoint: {
        '@type': 'ContactPoint',
        contactType: 'support',
        email: 'support@avocloud.net',
        url: 'https://avocloud.net/mail/',
      },
    },
    {
      '@type': 'WebSite',
      '@id': 'https://avocloud.net/#website',
      url: 'https://avocloud.net/',
      name: 'Avocloud.net',
      publisher: { '@id': 'https://avocloud.net/#org' },
      inLanguage: ['en', 'de'],
    },
    {
      '@type': 'WebPage',
      '@id': 'https://avocloud.net/#webpage',
      url: 'https://avocloud.net/',
      name: title,
      isPartOf: { '@id': 'https://avocloud.net/#website' },
      about: { '@id': 'https://avocloud.net/#org' },
      inLanguage: 'en',
      primaryImageOfPage: 'https://avocloud.net/assets/images/logo.png',
    },
    {
      '@type': 'ItemList',
      name: 'Avocloud.net projects',
      itemListElement: [
        { '@type': 'ListItem', position: 1, name: 'Baxi', url: 'https://avocloud.net/baxi/', description: 'Verified Discord moderation bot with intelligent chat filter and global spammer database.' },
        { '@type': 'ListItem', position: 2, name: 'PWGEN', url: 'https://avocloud.net/pwgen/', description: 'Secure, customizable password generator.' },
        { '@type': 'ListItem', position: 3, name: 'SafeText', url: 'https://github.com/AvoCloud-net/SafeText', description: 'API server that scans text for offensive language. Powers Baxi and AvoFilter.' },
        { '@type': 'ListItem', position: 4, name: 'SkyFire', url: 'https://avocloud.net/skyfire/', description: 'MicroServer hosting service for projects, websites and Minecraft servers.' },
        { '@type': 'ListItem', position: 5, name: 'QrGate', url: 'https://avocloud.net/qrgate/', description: 'Open-source ticketing system with shop, PayPal, email delivery and QR check-in.' },
        { '@type': 'ListItem', position: 6, name: 'Ember', url: 'https://github.com/rwolf2467/ember', description: 'Instagram-like social media platform, now a public archive.' },
        { '@type': 'ListItem', position: 7, name: 'AvoFilter', url: 'https://modrinth.com/plugin/avofilter', description: 'Minecraft chat-filter plugin powered by SafeText.' },
        { '@type': 'ListItem', position: 8, name: 'EduGrade', url: 'https://avocloud.net/edugrade/', description: 'Free, GDPR-compliant grade management for teachers with AES-256-GCM encryption.' },
        { '@type': 'ListItem', position: 9, name: 'Craft Attack', url: 'https://avocloud.net/craftattack/', description: 'Open Craft Attack community Minecraft server — Season 2: The Ashes of Aerlon.' },
        { '@type': 'ListItem', position: 10, name: 'AvoLink', url: 'https://avolink.net/', description: 'Free link shortener and Linktree alternative — create short branded URLs and a single profile page for all your social links. By Avocloud.net.' },
      ],
    },
    {
      '@type': 'BreadcrumbList',
      itemListElement: [{ '@type': 'ListItem', position: 1, name: 'Home', item: 'https://avocloud.net/' }],
    },
    {
      '@type': 'FAQPage',
      mainEntity: [
        { '@type': 'Question', name: 'What is Avocloud.net?', acceptedAnswer: { '@type': 'Answer', text: 'Avocloud.net is an open-source software development group from Austria and Germany, founded in 2024. We build Discord bots, Minecraft plugins, web utilities, and operate an open Craft Attack community Minecraft server. All our projects are MIT-licensed and freely available on GitHub.' } },
        { '@type': 'Question', name: 'Are Avocloud projects free?', acceptedAnswer: { '@type': 'Answer', text: 'Yes. All our projects (Baxi, AvoFilter, EduGrade, QrGate, PWGEN, SafeText, the Craft Attack server, and more) are free to use. Source code is open source under the MIT license on GitHub.' } },
        { '@type': 'Question', name: 'How can I contact Avocloud.net?', acceptedAnswer: { '@type': 'Answer', text: 'Join our Discord at avocloud.net/discord, email support@avocloud.net, or open issues on our GitHub at github.com/AvoCloud-net.' } },
        { '@type': 'Question', name: 'What is the Baxi Discord bot?', acceptedAnswer: { '@type': 'Answer', text: 'Baxi is our verified Discord moderation bot with an intelligent chat filter, global spammer database, account-linking for the Craft Attack server, and many more features. Free and open source.' } },
      ],
    },
  ],
};
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{title}</title>
    <link rel="icon" href="/assets/images/favicon.svg" type="image/svg+xml" />
    <link rel="icon" href="/favicon.ico" sizes="any" />
    <link rel="apple-touch-icon" href="/assets/images/apple-touch-icon.png" />
    <meta name="description" content={description} />
    <meta
      name="keywords"
      content="Avocloud, Avocloud.net, open source, Discord bot, Minecraft plugin, Baxi, AvoFilter, EduGrade, QrGate, PWGEN, SafeText, SkyFire, Craft Attack, CraftAttack, AvoLink, open-source software, MIT license, Discord moderation, Minecraft server, ticketing system, password generator, Notenverwaltung, Softwareentwicklung Österreich, Open Source Deutschland"
    />
    <meta name="author" content="Avocloud.net" />
    <meta name="robots" content={noindex ? 'noindex, nofollow' : 'index, follow, max-image-preview:large, max-snippet:-1'} />
    <meta name="googlebot" content={noindex ? 'noindex, nofollow' : 'index, follow'} />
    <link rel="canonical" href={canonical} />
    <link rel="alternate" hreflang="en" href={canonical} />
    <link rel="alternate" hreflang="de" href={`${canonical}${canonical.includes('?') ? '&' : '?'}lang=de`} />
    <link rel="alternate" hreflang="x-default" href={canonical} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content="https://avocloud.net/assets/images/logo.png" />
    <meta property="og:image:alt" content="Avocloud.net logo" />
    <meta property="og:url" content={canonical} />
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="Avocloud.net" />
    <meta property="og:locale" content="en_US" />
    <meta property="og:locale:alternate" content="de_DE" />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content="https://avocloud.net/assets/images/logo.png" />
    <meta name="theme-color" content="#000000" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    {includeSchema && <script type="application/ld+json" set:html={JSON.stringify(schema)} />}
    <!-- Arm scroll-reveal hiding before first paint (no FOUC). Skipped when JS
         is off or the user prefers reduced motion → content stays visible. -->
    <script is:inline define:vars={{ INTRO: intro }}>
      if (!matchMedia('(prefers-reduced-motion: reduce)').matches) {
        document.documentElement.classList.add('gsap-ready');
        // Arm the load intro before first paint. Gated here (not in the
        // component) so that with JS off or reduced motion the overlay is never
        // displayed at all — nothing to remove, nothing to strand on.
        //
        // Runs on every load, not once per session: it is the brand's
        // handshake.
        //
        // Opt-in per page, and it MUST stay that way. `html.intro` sets
        // `overflow: hidden` and everything gated behind afterIntro() waits for
        // the completion event — both of which only ever get undone by the
        // <Intro> component. Arm it on a page that doesn't render <Intro> and
        // that page is left permanently unscrollable with its entrance
        // animations never firing.
        if (INTRO) document.documentElement.classList.add('intro');

        /* Arriving half of the page transition. The outgoing page leaves a
           one-shot flag; consuming it here, before first paint, is what keeps
           the curtain from flashing the new page underneath.

           Deliberately flag-driven rather than unconditional: a visitor who
           arrives from a bookmark, a search result or a fresh tab has no
           outgoing page to continue from, and covering their first view for
           half a second would be a loading screen we invented. Only a
           navigation *from within the site* gets the curtain.

           Skipped when the load intro is running — that already owns the
           reveal, and two curtains for one navigation is one too many. */
        try {
          var pt = sessionStorage.getItem('avo:pt');
          sessionStorage.removeItem('avo:pt');
          // The flag carries a timestamp and is only honoured while fresh.
          // Links into the legacy static pages are intercepted like any other
          // same-origin link, but those pages never consume the flag — without
          // an expiry it would sit there and make some later arrival play an
          // uncovering animation that no outgoing page ever started.
          if (pt && Date.now() - Number(pt) < 3000 && !INTRO) {
            document.documentElement.classList.add('pt-in');
          }
        } catch (e) { /* storage blocked — just skip the effect */ }
      }
      // Always land on top on load/reload — stop the browser restoring
      // whatever scroll position the tab had before (esp. w/ Lenis + pins).
      if ('scrollRestoration' in history) history.scrollRestoration = 'manual';
      window.scrollTo(0, 0);
    </script>
  </head>
  <body>
    <div class="page-curtain" aria-hidden="true"></div>
    <slot />

    <script is:inline>
      /* Page transitions — see .page-curtain in global.css for the motion.
         Plain inline script, not an island: it has to be live on every page
         before any React hydrates, and it needs no framework to toggle two
         classes. */
      (function () {
        if (matchMedia('(prefers-reduced-motion: reduce)').matches) return;
        var html = document.documentElement;
        var OUT_MS = 300;  // must match .pt-out's transition duration

        /* Release the arriving curtain on the next frame. The rAF is what
           guarantees the browser painted the covered state first, so the
           transition has something to animate from; the timeout is the escape
           hatch for a throttled or background tab, where rAF can stall for
           seconds and would otherwise leave the page covered and unscrollable. */
        if (html.classList.contains('pt-in')) {
          var released = false;
          var release = function () {
            if (released) return;
            released = true;
            html.classList.add('pt-go');
            setTimeout(function () { html.classList.remove('pt-in', 'pt-go'); }, 600);
          };
          requestAnimationFrame(function () { requestAnimationFrame(release); });
          setTimeout(release, 200);
        }

        document.addEventListener('click', function (e) {
          if (e.defaultPrevented || e.button !== 0) return;
          // modifier clicks mean "open elsewhere" — never animate those, the
          // current page isn't going anywhere
          if (e.metaKey || e.ctrlKey || e.shiftKey || e.altKey) return;

          var a = e.target.closest && e.target.closest('a[href]');
          if (!a || a.target || a.hasAttribute('download')) return;

          var url;
          try { url = new URL(a.href); } catch (err) { return; }
          if (url.origin !== location.origin) return;            // leaving the site
          if (url.protocol !== 'http:' && url.protocol !== 'https:') return;
          // in-page anchor: no navigation happens, so there is nothing to cover
          if (url.pathname === location.pathname && url.search === location.search) return;

          e.preventDefault();
          try { sessionStorage.setItem('avo:pt', String(Date.now())); } catch (err) { /* ignore */ }
          html.classList.add('pt-out');
          setTimeout(function () { location.href = a.href; }, OUT_MS);
        });

        /* Back/forward out of the bfcache restores the DOM exactly as it was
           left — including a raised curtain — which would show the returning
           visitor a blank screen. This is the bug in every "fade the body out
           on click" recipe. */
        window.addEventListener('pageshow', function (ev) {
          if (ev.persisted) html.classList.remove('pt-out', 'pt-in', 'pt-go');
        });
      })();
    </script>
  </body>
</html>
