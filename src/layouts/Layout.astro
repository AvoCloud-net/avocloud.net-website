---
import '@/styles/global.css';
import { company, legalName } from '@/data/company';

interface Props {
  title?: string;
  description?: string;
  canonical?: string;
  /** Skip the org/website/webpage/FAQ JSON-LD graph — only the homepage needs it. */
  schema?: boolean;
  /** Page-specific structured data (Article, BreadcrumbList, ...) for pages
      that carry their own instead of the site-wide graph. */
  jsonld?: unknown;
  /** Social preview image (absolute URL). Defaults to the site logo; pages
      with a real visual of their own should pass it, or every share of every
      page looks identical in a timeline. */
  ogImage?: string;
  ogImageAlt?: string;
  /** Document language. The site is English; /edugrade/ is written in German
      for German-speaking teachers and has to say so, or a screen reader
      pronounces the whole page with English phonetics. */
  lang?: string;
  /** Announce a German alternate. Only the homepage has one: its copy lives in
      content.ts with both languages, every subpage is English-only markup.
      Claiming hreflang on those pointed Google at a URL that serves the same
      English text, which is worse than declaring nothing. */
  i18n?: boolean;
  noindex?: boolean;
}

// Defaults reproduce the previous hardcoded homepage values exactly.
const {
  title = 'Avocloud.net | Software from Austria',
  description = 'Avocloud.net develops software in Wels, Austria. Discord moderation (Baxi), event ticketing (QrGate), grade management (EduGrade) and web development.',
  canonical = 'https://avocloud.net/',
  schema: includeSchema = true,
  jsonld,
  noindex = false,
  i18n = false,
  lang = 'en',
  ogImage = 'https://avocloud.net/assets/images/logo.png',
  ogImageAlt = 'Avocloud.net logo',
} = Astro.props;

const schema = {
  '@context': 'https://schema.org',
  '@graph': [
    {
      '@type': 'Organization',
      '@id': 'https://avocloud.net/#org',
      name: 'Avocloud.net',
      alternateName: 'Avocloud',
      legalName,
      url: 'https://avocloud.net/',
      logo: 'https://avocloud.net/assets/images/logo.png',
      image: 'https://avocloud.net/assets/images/logo.png',
      foundingDate: String(company.founded),
      description:
        'Software developer from Wels, Austria. Develops and operates Discord moderation, event ticketing and grade management products, and builds websites and web applications.',
      address: {
        '@type': 'PostalAddress',
        streetAddress: company.street,
        postalCode: company.postalCode,
        addressLocality: company.city,
        addressCountry: company.countryCode,
      },
      ...(company.uid ? { vatID: company.uid } : {}),
      areaServed: ['AT', 'DE', 'Worldwide'],
      knowsAbout: [
        'Software development', 'Discord bot development', 'Event ticketing',
        'Web development', 'Data protection',
      ],
      sameAs: ['https://avocloud.net/discord/', 'https://avolink.net/'],
      contactPoint: {
        '@type': 'ContactPoint',
        contactType: 'customer support',
        email: company.supportEmail,
        url: 'https://avocloud.net/mail/',
        availableLanguage: ['en', 'de'],
      },
    },
    {
      '@type': 'WebSite',
      '@id': 'https://avocloud.net/#website',
      url: 'https://avocloud.net/',
      name: 'Avocloud.net',
      publisher: { '@id': 'https://avocloud.net/#org' },
      inLanguage: ['en', 'de'],
    },
    {
      '@type': 'WebPage',
      '@id': 'https://avocloud.net/#webpage',
      url: 'https://avocloud.net/',
      name: title,
      isPartOf: { '@id': 'https://avocloud.net/#website' },
      about: { '@id': 'https://avocloud.net/#org' },
      inLanguage: 'en',
      primaryImageOfPage: 'https://avocloud.net/assets/images/logo.png',
    },
    {
      '@type': 'ItemList',
      name: 'Avocloud.net products',
      itemListElement: [
        { '@type': 'ListItem', position: 1, name: 'Baxi', url: 'https://avocloud.net/baxi/', description: 'Verified Discord moderation bot with intelligent chat filter and global spammer database.' },
        { '@type': 'ListItem', position: 2, name: 'QrGate', url: 'https://avocloud.net/qrgate/', description: 'Event ticketing with shop, PayPal, email delivery and QR check-in.' },
        { '@type': 'ListItem', position: 3, name: 'EduGrade', url: 'https://avocloud.net/edugrade/', description: 'GDPR-compliant grade management for teachers with AES-256-GCM encryption.' },
        { '@type': 'ListItem', position: 4, name: 'DiscordGate', url: 'https://modrinth.com/plugin/discordgate', description: 'Minecraft plugin that requires Discord account linking before players can join. Works with Baxi.' },
        { '@type': 'ListItem', position: 5, name: 'AvoLink', url: 'https://avolink.net/', description: 'Link shortener and Linktree alternative.' },
        { '@type': 'ListItem', position: 6, name: 'Craft Attack', url: 'https://avocloud.net/craftattack/', description: 'Community Minecraft server, Season 2: The Ashes of Aerlon.' },
      ],
    },
    {
      '@type': 'BreadcrumbList',
      itemListElement: [{ '@type': 'ListItem', position: 1, name: 'Home', item: 'https://avocloud.net/' }],
    },
    {
      '@type': 'FAQPage',
      mainEntity: [
        { '@type': 'Question', name: 'What is Avocloud.net?', acceptedAnswer: { '@type': 'Answer', text: 'Avocloud.net develops and operates software from Wels, Austria: our own products (Baxi, QrGate, EduGrade) and websites and web applications.' } },
        { '@type': 'Question', name: 'How can I contact Avocloud.net?', acceptedAnswer: { '@type': 'Answer', text: 'Email support@avocloud.net, use the contact page at avocloud.net/mail, or join our Discord at avocloud.net/discord. Our imprint is at avocloud.net/impressum.' } },
        { '@type': 'Question', name: 'What is the Baxi Discord bot?', acceptedAnswer: { '@type': 'Answer', text: 'Baxi is our verified Discord moderation bot with an intelligent chat filter, a global spammer database, account linking for Minecraft servers and a web dashboard.' } },
        { '@type': 'Question', name: 'What is QrGate?', acceptedAnswer: { '@type': 'Answer', text: 'QrGate is our event ticketing system: an online shop, PDF tickets with QR codes by email, box office sales and QR check-in at the door. It runs the ticketing for Helenenbühne Sattledt.' } },
      ],
    },
  ],
};
---

<!doctype html>
<html lang={lang}>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{title}</title>
    <link rel="icon" href="/assets/images/favicon.svg" type="image/svg+xml" />
    <link rel="icon" href="/favicon.ico" sizes="any" />
    <link rel="apple-touch-icon" href="/assets/images/apple-touch-icon.png" />
    <meta name="description" content={description} />
    <meta
      name="keywords"
      content="Avocloud, Avocloud.net, Softwareentwicklung Österreich, Software Wels, Discord bot, Baxi, QrGate, EduGrade, DiscordGate, AvoLink, Ticketing, Eventticketing, Notenverwaltung, Webentwicklung, Hosting"
    />
    <meta name="author" content={legalName} />
    <meta name="robots" content={noindex ? 'noindex, nofollow' : 'index, follow, max-image-preview:large, max-snippet:-1'} />
    <meta name="googlebot" content={noindex ? 'noindex, nofollow' : 'index, follow'} />
    <link rel="canonical" href={canonical} />
    {i18n && (
      <>
        <link rel="alternate" hreflang="en" href={canonical} />
        <link rel="alternate" hreflang="de" href={`${canonical}${canonical.includes('?') ? '&' : '?'}lang=de`} />
        <link rel="alternate" hreflang="x-default" href={canonical} />
      </>
    )}
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:alt" content={ogImageAlt} />
    <meta property="og:url" content={canonical} />
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="Avocloud.net" />
    <meta property="og:locale" content="en_US" />
    {i18n && <meta property="og:locale:alternate" content="de_DE" />}
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImage} />
    <meta name="theme-color" content="#000000" />
    <link rel="preconnect" href="https://cdn.avocloud.net" crossorigin />
    {includeSchema && <script type="application/ld+json" set:html={JSON.stringify(schema)} />}
    {jsonld && <script type="application/ld+json" set:html={JSON.stringify(jsonld)} />}
    <!-- Arm scroll-reveal hiding before first paint (no FOUC). Skipped when JS
         is off or the user prefers reduced motion → content stays visible. -->
    <script is:inline>
      if (!matchMedia('(prefers-reduced-motion: reduce)').matches) {
        document.documentElement.classList.add('gsap-ready');
        /* Arriving half of the page transition. The outgoing page leaves a
           one-shot flag; consuming it here, before first paint, is what keeps
           the curtain from flashing the new page underneath.

           Deliberately flag-driven rather than unconditional: a visitor who
           arrives from a bookmark, a search result or a fresh tab has no
           outgoing page to continue from, and covering their first view for
           half a second would be a loading screen we invented. Only a
           navigation *from within the site* gets the curtain. */
        try {
          var pt = sessionStorage.getItem('avo:pt');
          sessionStorage.removeItem('avo:pt');
          // The flag carries a timestamp and is only honoured while fresh.
          // Links into the legacy static pages are intercepted like any other
          // same-origin link, but those pages never consume the flag — without
          // an expiry it would sit there and make some later arrival play an
          // uncovering animation that no outgoing page ever started.
          if (pt && Date.now() - Number(pt) < 3000) {
            document.documentElement.classList.add('pt-in');
          }
        } catch (e) { /* storage blocked — just skip the effect */ }
      }
      // Always land on top on load/reload — stop the browser restoring
      // whatever scroll position the tab had before (esp. w/ Lenis + pins).
      if ('scrollRestoration' in history) history.scrollRestoration = 'manual';
      window.scrollTo(0, 0);
    </script>
  </head>
  <body>
    <!-- First focusable thing on every page: the nav is 6+ links deep and sits
         in front of the content on every single one of them. -->
    <a class="skip-link" href="#main">Skip to content</a>
    <div class="page-curtain" aria-hidden="true"></div>
    <slot />

    <script is:inline>
      /* Page transitions — see .page-curtain in global.css for the motion.
         Plain inline script, not an island: it has to be live on every page
         before any React hydrates, and it needs no framework to toggle two
         classes. */
      (function () {
        if (matchMedia('(prefers-reduced-motion: reduce)').matches) return;
        var html = document.documentElement;
        var OUT_MS = 300;  // must match .pt-out's transition duration

        /* Release the arriving curtain on the next frame. The rAF is what
           guarantees the browser painted the covered state first, so the
           transition has something to animate from; the timeout is the escape
           hatch for a throttled or background tab, where rAF can stall for
           seconds and would otherwise leave the page covered and unscrollable. */
        if (html.classList.contains('pt-in')) {
          var released = false;
          var release = function () {
            if (released) return;
            released = true;
            html.classList.add('pt-go');
            setTimeout(function () { html.classList.remove('pt-in', 'pt-go'); }, 600);
          };
          requestAnimationFrame(function () { requestAnimationFrame(release); });
          setTimeout(release, 200);
        }

        document.addEventListener('click', function (e) {
          if (e.defaultPrevented || e.button !== 0) return;
          // modifier clicks mean "open elsewhere" — never animate those, the
          // current page isn't going anywhere
          if (e.metaKey || e.ctrlKey || e.shiftKey || e.altKey) return;

          var a = e.target.closest && e.target.closest('a[href]');
          if (!a || a.target || a.hasAttribute('download')) return;

          var url;
          try { url = new URL(a.href); } catch (err) { return; }
          if (url.origin !== location.origin) return;            // leaving the site
          if (url.protocol !== 'http:' && url.protocol !== 'https:') return;
          // in-page anchor: no navigation happens, so there is nothing to cover
          if (url.pathname === location.pathname && url.search === location.search) return;

          e.preventDefault();
          try { sessionStorage.setItem('avo:pt', String(Date.now())); } catch (err) { /* ignore */ }
          html.classList.add('pt-out');
          setTimeout(function () { location.href = a.href; }, OUT_MS);
        });

        /* Back/forward out of the bfcache restores the DOM exactly as it was
           left — including a raised curtain — which would show the returning
           visitor a blank screen. This is the bug in every "fade the body out
           on click" recipe. */
        window.addEventListener('pageshow', function (ev) {
          if (ev.persisted) html.classList.remove('pt-out', 'pt-in', 'pt-go');
        });
      })();
    </script>
  </body>
</html>
