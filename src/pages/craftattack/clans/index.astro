---
import Layout from '@/layouts/Layout.astro';
import Shell from '@/components/Shell.tsx';
import CaPage from '@/components/CaPage.astro';

const url = 'https://avocloud.net/craftattack/clans/';
const jsonld = {
  '@context': 'https://schema.org',
  '@graph': [
    {
      '@type': 'BreadcrumbList',
      itemListElement: [
        { '@type': 'ListItem', position: 1, name: 'Home', item: 'https://avocloud.net/' },
        { '@type': 'ListItem', position: 2, name: 'Craft Attack', item: 'https://avocloud.net/craftattack/' },
        { '@type': 'ListItem', position: 3, name: 'Clans, Jobs & Economy', item: url },
      ],
    },
    {
      '@type': 'Article',
      headline: 'Clans, Jobs & Economy — Craft Attack Community Server',
      description:
        'Clan system, jobs, coin economy and claims on the open Avocloud Craft Attack server, Season 2.',
      image: 'https://avocloud.net/assets/images/craftattack/ca-s2-4.webp',
      mainEntityOfPage: url,
      author: { '@type': 'Organization', name: 'Avocloud.net', url: 'https://avocloud.net/' },
      publisher: { '@id': 'https://avocloud.net/#org' },
    },
  ],
};
---

<Layout
  title="Clans, Jobs & Economy — Craft Attack Community Server | Avocloud.net"
  description="Craft Attack Season 2 clan system, jobs, coin economy and Homestead claims on the open Avocloud community server. Found a clan, claim land, earn coins, trade and ally."
  canonical={url}
  schema={false}
  ogImage="https://avocloud.net/assets/images/craftattack/ca-s2-4.webp"
  ogImageAlt="Craft Attack Season 2 — ancient columns in an overgrown plaza of Aerlon"
  jsonld={jsonld}
>
  <Shell client:load>
    <CaPage current="/craftattack/clans/" title="Clans, Jobs & Economy">
      <div class="article">
        <div class="section-label">CRAFT ATTACK SEASON 2</div>
        <h1 class="headline">Clans, Jobs &amp; Economy</h1>

        <p class="lede">
          The open <strong>Avocloud Craft Attack community server</strong> in
          <strong>Season 2 — The Ashes of Aerlon</strong> ships a full set of community systems:
          clans, jobs, a coin economy, flexible Homestead claims, and opt-in PvP. Everything here
          is free; coins are earned, not bought.
        </p>

        <h2>Clan System</h2>
        <p>
          Found a clan, share a base, declare wars or forge alliances. Each clan gets its own chat
          (<code>/cc</code>), bank balance, home point, claim area, and shared chest. Roles:
          Leader · Manager · Member. Alliances and Clan Wars require mutual consent — wars are
          opt-in, auto-end after 7 days, do not allow base destruction, and grave protection still
          applies.
        </p>

        <h2>Coin Economy</h2>
        <p>
          Every player starts with 500 coins. Earn more through mob kills, playtime bonuses, jobs,
          and trading with other players. Coins fund Homestead claim expansion beyond the free
          500 blocks², clan founding, alliances, and player-driven shops.
        </p>

        <h2>Jobs System</h2>
        <p>
          Pick one of four jobs and earn coins through your normal playstyle — mining, building,
          farming, hunting. Only one job at a time. Browse with <code>/jobs browse</code>. Jobs are
          entirely optional but the most reliable income stream for funding clan and claim growth.
        </p>

        <h2>Homestead Claims</h2>
        <p>
          Flexible region claims, not just chunks — claim any shape with 75+ permission flags.
          First 500 blocks² are free; beyond that costs coins. Auto-unclaim only triggers when
          upkeep can't be paid (insufficient balance on <code>/money</code>). Default rule keeps
          some distance to neighboring claims; directly adjacent claims allowed only with explicit
          consent of the affected claim holder.
        </p>

        <h2>Opt-in PvP</h2>
        <p>
          PvP is off by default. Enable with <code>/pvp on</code>; disabling has a 24h cooldown.
          New players are auto-protected for 48h. Spawn (500 block radius) is always PvP-free.
          Combat Tag locks logout/teleport/toggle for 15 seconds. Walling-in players where they
          can't free themselves is forbidden (see
          <a class="accent-link" href="/craftattack/rules/">Server Rules</a>).
        </p>

        <h2>Join</h2>
        <p>
          Server address: <code>craftattack.avocloud.net</code> · Free, no application form. Link
          Discord + Minecraft via the Baxi bot using <code>/mc link</code> to get whitelisted
          automatically.
        </p>
        <p class="mt">
          <a class="btn primary" href="/craftattack/join/">How to join</a>
        </p>
      </div>
    </CaPage>
  </Shell>
</Layout>
