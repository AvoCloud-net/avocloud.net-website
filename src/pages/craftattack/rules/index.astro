---
/* Craftattack rules. Its own page so "read the rules" is one link. One column,
   read top to bottom. */
import Layout from '@/layouts/Layout.astro';
import CommunityApp from '@/components/CommunityApp.tsx';
import { copy, facts } from '@/data/community';

const c = copy.de.rulesPage;
const url = 'https://avocloud.net/craftattack/rules/';

const jsonld = {
  '@context': 'https://schema.org',
  '@graph': [
    {
      '@type': 'BreadcrumbList',
      itemListElement: [
        { '@type': 'ListItem', position: 1, name: 'Home', item: 'https://avocloud.net/' },
        { '@type': 'ListItem', position: 2, name: facts.name ?? 'Community Server', item: 'https://avocloud.net/craftattack/' },
        { '@type': 'ListItem', position: 3, name: c.label, item: url },
      ],
    },
  ],
};
---
<Layout
  title={c.meta.title}
  description={c.meta.description}
  canonical={url}
  lang="de"
  schema={false}
  ogImage="https://avocloud.net/assets/images/craftattack/ca-og.jpg"
  ogImageAlt={copy.de.meta.ogImageAlt}
  themeColor="#f5b85c"
  noindex={!facts.launched}
  jsonld={jsonld}
>
  <CommunityApp client:load hero={false}>
    <section class="section mc-subpage">
      <div class="wrap mc-narrow">
        <a class="mc-back" href="/craftattack/">
          <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M19 12H5M11 18l-6-6 6-6" /></svg>
          {copy.de.back}
        </a>
        <div class="section-label">{c.label}</div>
        <h1 class="headline">{c.headline}</h1>
        <p class="ca-p">{c.intro}</p>

        <ol class="mc-rules">
          {c.items.map((r, i) => (
            <li>
              <span class="ca-rule-n">{String(i + 1).padStart(2, '0')}</span>
              <div>
                <h3>{r.title}</h3>
                <p set:html={r.body} />
              </div>
            </li>
          ))}
        </ol>

        <div class="card mc-rules-help">
          <span class="mk tl"></span><span class="mk br"></span>
          <h3>{c.help.title}</h3>
          <p set:html={c.help.body} />
        </div>
        <p class="ca-p mc-rules-note">{c.note}</p>

        <div class="ca-actions">
          <a class="btn primary" href="/craftattack/join/">{c.join}</a>
        </div>
      </div>
    </section>
  </CommunityApp>
</Layout>
