---
/* How to join Craftattack, step by step for Java and Bedrock. Its own page so
   it can be linked directly (Discord, the main page's "Ready to play?"). */
import Layout from '@/layouts/Layout.astro';
import CommunityApp from '@/components/CommunityApp.tsx';
import { copy, facts, todo } from '@/data/community';

const c = copy.de.joinPage;
const url = 'https://avocloud.net/craftattack/join/';

const jsonld = {
  '@context': 'https://schema.org',
  '@graph': [
    {
      '@type': 'BreadcrumbList',
      itemListElement: [
        { '@type': 'ListItem', position: 1, name: 'Home', item: 'https://avocloud.net/' },
        { '@type': 'ListItem', position: 2, name: facts.name ?? 'Community Server', item: 'https://avocloud.net/craftattack/' },
        { '@type': 'ListItem', position: 3, name: c.label, item: url },
      ],
    },
  ],
};
---
<Layout
  title={c.meta.title}
  description={c.meta.description}
  canonical={url}
  lang="de"
  schema={false}
  ogImage="https://avocloud.net/assets/images/craftattack/ca-og.jpg"
  ogImageAlt={copy.de.meta.ogImageAlt}
  themeColor="#f5b85c"
  noindex={!facts.launched}
  jsonld={jsonld}
>
  <CommunityApp client:load hero={false}>
    <section class="section mc-subpage">
      <div class="wrap">
        <a class="mc-back" href="/craftattack/">
          <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M19 12H5M11 18l-6-6 6-6" /></svg>
          {copy.de.back}
        </a>
        <div class="section-label">{c.label}</div>
        <h1 class="headline">{c.headline}</h1>
        <p class="ca-p">{c.intro}</p>

        <div class="ca-address">
          <span class="ca-address-l">{c.addressLabel}</span>
          <code class="ca-address-v" set:html={facts.address ?? todo('server address')} />
          <button
            type="button"
            class="btn"
            data-copy={facts.address ?? ''}
            data-copied={c.copied}
            aria-label={c.copyAria}
            disabled={!facts.address}
          >
            <span data-copy-label>{c.copy}</span>
          </button>
        </div>

        <div class="grid cols-2 mc-editions">
          {c.editions.map((e) => (
            <div class="mc-edition" id={e.id}>
              <h2>{e.title}<small>{e.note}</small></h2>
              <ol class="mc-steps">
                {e.steps.map((s, i) => (
                  <li>
                    <span class="ca-step-n">{i + 1}</span>
                    <div>
                      <h3>{s.title}</h3>
                      <p set:html={s.body} />
                    </div>
                  </li>
                ))}
              </ol>
            </div>
          ))}
        </div>

        <div class="grid cols-2 mc-join-extra">
          {[c.voice, c.help].map((b) => (
            <div class="card">
              <span class="mk tl"></span><span class="mk br"></span>
              <h3>{b.title}</h3>
              <p set:html={b.body} />
            </div>
          ))}
        </div>

        <div class="ca-actions">
          <a class="btn primary" href={facts.discord}>{c.discord}</a>
          <a class="btn" href="/craftattack/rules/">{c.rules}</a>
        </div>
      </div>
    </section>
  </CommunityApp>
</Layout>

<script>
  document.addEventListener('click', (e) => {
    const btn = (e.target as HTMLElement).closest<HTMLButtonElement>('[data-copy]');
    if (!btn || btn.disabled || !btn.dataset.copy) return;
    const label = btn.querySelector('[data-copy-label]');
    const idle = label?.textContent ?? '';
    navigator.clipboard?.writeText(btn.dataset.copy).then(() => {
      if (!label) return;
      label.textContent = btn.dataset.copied ?? idle;
      setTimeout(() => (label.textContent = idle), 1600);
    });
  });
</script>
