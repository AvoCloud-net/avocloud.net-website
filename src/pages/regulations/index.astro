---
import Layout from '@/layouts/Layout.astro';
import Shell from '@/components/Shell.tsx';
---
<Layout
  title="Legal Notices & Regulations – Avocloud.net"
  description="Legal notices and regulations for Avocloud.net services."
  canonical="https://avocloud.net/regulations/"
  schema={false}
>
  <Shell client:load>
    <main class="section" id="regulations">
      <div class="wrap">
        <div class="section-label">AVOCLOUD.NET</div>
        <h1 class="headline" style="margin-bottom: 1rem;">Legal notices &amp; regulations</h1>
        <p style="color: var(--muted); margin-bottom: 2.5rem;">
          Here you will find our ToS, Privacy Policy and more.
        </p>

        <!-- Quick Navigation -->
        <section id="toc" style="margin-bottom: 2.5rem;">
          <div class="section-label">CONTENTS</div>
          <div class="card">
            <span class="mk tl"></span><span class="mk br"></span>
            <h3>
              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round">
                <line x1="8" y1="6" x2="21" y2="6"/><line x1="8" y1="12" x2="21" y2="12"/><line x1="8" y1="18" x2="21" y2="18"/>
                <line x1="3" y1="6" x2="3.01" y2="6"/><line x1="3" y1="12" x2="3.01" y2="12"/><line x1="3" y1="18" x2="3.01" y2="18"/>
              </svg>
              Quick Navigation
            </h3>
            <ul style="list-style: none; padding: 0; display: flex; flex-direction: column; gap: 0.4rem;">
              <li><a href="#privacy" class="accent-link">Data Protection Regulations</a></li>
              <li><a href="#tos" class="accent-link">Terms of Service</a></li>
              <li><a href="#sds" class="accent-link">Service Description Summary</a></li>
              <li><a href="#drr" class="accent-link">Discord Related Rules</a></li>
              <li><a href="#contact" class="accent-link">Contact Information</a></li>
            </ul>
          </div>
        </section>

        <!-- Privacy Policy -->
        <section id="privacy" style="margin-bottom: 2.5rem;">
          <div class="section-label">DATA PROTECTION REGULATIONS</div>
          <div class="card">
            <span class="mk tl"></span><span class="mk br"></span>
            <h3>
              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"><path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"/></svg>
              Our Privacy Policy
            </h3>
            <p style="font-family: var(--font-mono); font-size: 0.8rem; margin-bottom: 1rem;">Last update: 21.08.2025</p>

            <p>
              In the points and sub-points below you will find all the necessary information regarding
              privacy. It explains how we handle the data, what we store and more.<br /><br />
              Users may contact us by <a href="https://avocloud.net/mail/" class="accent-link">e-mail</a>
              to request a copy of the information we have on file or to have it deleted.
            </p>

            <h4 class="reg-h3">Data Security</h4>
            <p>
              All data is stored on our own servers, accessible only to members of our administration team.
              Our use of self-developed or open source programs ensures transparency and accountability.<br /><br />
              We don't use any kind of tracking in our systems. Some pages, like the hosting dashboard or
              our Baxi dashboard, use cookies to save the login session.
            </p>

            <h4 class="reg-h3">Your Rights</h4>
            <p>Under applicable privacy laws, you have certain rights:</p>
            <ul class="reg-list">
              <li><strong>Right to Access:</strong> You may request a copy of the personal data we hold about you.</li>
              <li><strong>Right to Rectification:</strong> You may ask us to correct inaccurate or incomplete data.</li>
              <li><strong>Right to Erasure:</strong> You may request deletion of your personal data, subject to certain exceptions.</li>
              <li><strong>Right to Restriction:</strong> You may ask us to stop processing all or some of your personal data.</li>
              <li><strong>Right to Data Portability:</strong> You may request a copy of your data in a machine-readable format.</li>
            </ul>
            <p>
              To exercise any of these rights, contact us at
              <a href="mailto:support@avocloud.net" class="accent-link">support@avocloud.net</a>.
              We will respond to all legitimate requests within 30 days.
            </p>

            <h4 class="reg-h3">Baxi</h4>
            <p>
              Baxi has its own dedicated privacy policy. Please refer to the Baxi privacy policy for all
              information regarding data processing by the bot:
            </p>
            <ul class="reg-list">
              <li><a href="https://baxi.avocloud.net/privacy/" class="accent-link" target="_blank" rel="noreferrer">baxi.avocloud.net/privacy ↗</a></li>
            </ul>

            <h4 class="reg-h3">SkyFire</h4>
            <p>
              We try to safeguard your privacy with our SkyFire hosting services. However, to ensure
              compliance with our hosting policies, we reserve the right to conduct random audits of
              customer servers.
            </p>
            <p>The following team members have access to customer servers:</p>
            <ul class="reg-list">
              <li>Red_wolf2467 – <a href="mailto:redwolf2467@avocloud.net" class="accent-link">redwolf2467@avocloud.net</a></li>
            </ul>

            <h4 class="reg-h3">Minecraft</h4>
            <p>
              We run several Minecraft servers, all operated via Paper. All standard information is
              stored on our servers. We use custom anti-cheat software called "IAC" (illegal anticheat).
            </p>

            <h4 class="reg-h3">AvoFilter – Plugin</h4>
            <p>
              Our Minecraft plugin "AvoFilter" sends every message to our self-developed
              <a href="https://github.com/rwolf2467/SafeText" class="accent-link" target="_blank" rel="noreferrer">SafeText</a>
              backend. No data or requests are stored. The backend keeps data in working memory only
              until the request is complete, then deletes it.
            </p>

            <h4 class="reg-h3">SafeText Server</h4>
            <ul class="reg-list">
              <li>We do not store any information about the content sent. All data is deleted after the request is processed.</li>
              <li>Communication between API client is secured with HTTPS &amp; HSTS.</li>
              <li>The code is available on <a href="https://github.com/AvoCloud-net/SafeText" class="accent-link" target="_blank" rel="noreferrer">GitHub</a> for transparency.</li>
            </ul>

            <p>
              We try to develop as much as possible ourselves, and only use open source software where
              possible. We at avocloud.net <strong>do not give away, sell or share any of the data we
              process or collect.</strong>
            </p>
          </div>
        </section>

        <!-- Terms of Service -->
        <section id="tos" style="margin-bottom: 2.5rem;">
          <div class="section-label">TERMS OF SERVICE</div>
          <div class="card">
            <span class="mk tl"></span><span class="mk br"></span>
            <h3>
              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round">
                <path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"/><polyline points="14 2 14 8 20 8"/>
                <line x1="16" y1="13" x2="8" y2="13"/><line x1="16" y1="17" x2="8" y2="17"/><polyline points="10 9 9 9 8 9"/>
              </svg>
              Terms of Service
            </h3>
            <p style="font-family: var(--font-mono); font-size: 0.8rem; margin-bottom: 1rem;">Last update: 21.08.2025</p>

            <p>
              By accessing and using our services, you agree to comply with these Terms of Service. These
              terms are designed to protect both our users and our infrastructure.
            </p>

            <h4 class="reg-h3">General Rules</h4>
            <p>Violation of these terms may result in immediate suspension or permanent termination.</p>
            <ul class="reg-list">
              <li><strong>Lawful Use:</strong> You may not use our services for any illegal purposes or activities that violate Austrian law or applicable local laws.</li>
              <li><strong>Bug Reporting:</strong> If you discover any vulnerability, bug, or security issue, you must report it immediately. Exploiting such issues is strictly forbidden and may result in legal action.</li>
              <li><strong>User Responsibility:</strong> You are solely responsible for your use of our services and any content you share or generate.</li>
              <li><strong>Loopholes &amp; Grey Areas:</strong> Attempting to exploit ambiguities in these terms or our systems is prohibited.</li>
              <li><strong>Circumvention:</strong> Evading bans, suspensions, or other disciplinary measures is not allowed.</li>
              <li><strong>Service Integrity:</strong> Any actions that disrupt, overload, or harm our services (e.g., DDoS attacks, spamming, brute-force) are forbidden.</li>
              <li><strong>Age Requirement:</strong> You must be at least 13 years old to use our services.</li>
            </ul>

            <h4 class="reg-h3">Intellectual Property</h4>
            <ul class="reg-list">
              <li>Our name, logo, and all related names, logos, product and service names are trademarks of Avocloud.</li>
              <li>You may not use these marks without our prior written permission.</li>
              <li>Open source components are governed by their respective licenses.</li>
            </ul>

            <h4 class="reg-h3">Baxi (Discord Bot)</h4>
            <p>
              Baxi has its own dedicated Terms of Service. Please refer to the Baxi ToS for all
              terms applicable to the use of the bot:
            </p>
            <ul class="reg-list">
              <li><a href="https://baxi.avocloud.net/terms/" class="accent-link" target="_blank" rel="noreferrer">baxi.avocloud.net/terms ↗</a></li>
            </ul>

            <h4 class="reg-h3">SkyFire Hosting</h4>
            <ul class="reg-list">
              <li><strong>Illegal Content:</strong> Hosting, distributing, or promoting illegal content is strictly prohibited and will result in immediate termination.</li>
              <li><strong>Monetization:</strong> You may not resell or monetize access to SkyFire servers in any way.</li>
              <li><strong>Resource Usage:</strong> Our services are intended for development, testing, and small-scale projects. Excessive resource consumption may lead to throttling or termination.</li>
              <li><strong>Bug Exploitation:</strong> Do not exploit bugs in the hosting platform. Report any issues to us promptly.</li>
              <li><strong>Security:</strong> You are responsible for maintaining the security of your server and any content hosted on it.</li>
            </ul>

            <h4 class="reg-h3">Enforcement</h4>
            <p>We reserve the right to investigate and take appropriate action against any user who violates these terms. Actions may include:</p>
            <ul class="reg-list">
              <li>Issuing warnings</li>
              <li>Suspending access to services</li>
              <li>Permanently banning users or servers</li>
              <li>Reporting illegal activities to law enforcement</li>
            </ul>
            <p>
              These terms may be updated periodically. Continued use of our services constitutes
              acceptance of the updated terms.
            </p>
          </div>
        </section>

        <!-- Service Description Summary -->
        <section id="sds" style="margin-bottom: 2.5rem;">
          <div class="section-label">SERVICE DESCRIPTION SUMMARY</div>
          <div class="card">
            <span class="mk tl"></span><span class="mk br"></span>
            <h3>
              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round">
                <path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"/><polyline points="14 2 14 8 20 8"/>
              </svg>
              Service Description Summary (SDS)
            </h3>
            <p style="font-family: var(--font-mono); font-size: 0.8rem; margin-bottom: 1rem;">Last update: 21.08.2025</p>

            <p>This section provides additional details about the services we deem most important.</p>

            <h4 class="reg-h3">General</h4>
            <ul class="reg-list">
              <li>The availability of our services is not guaranteed on a continuous basis. Periods of unavailability may occur due to errors, maintenance, or other unforeseen circumstances.</li>
            </ul>

            <h4 class="reg-h3">Service Level Expectations</h4>
            <ul class="reg-list">
              <li>We aim for 99% uptime for all services but cannot guarantee uninterrupted access.</li>
              <li>Scheduled maintenance will be announced at least 24 hours in advance when possible.</li>
              <li>Emergency maintenance may occur without prior notice to address critical issues.</li>
              <li>Support response times vary based on complexity and team availability.</li>
            </ul>

            <h4 class="reg-h3">Baxi</h4>
            <p>For service-level information regarding Baxi, please refer to the dedicated Baxi pages:</p>
            <ul class="reg-list">
              <li><a href="https://baxi.avocloud.net/privacy/" class="accent-link" target="_blank" rel="noreferrer">baxi.avocloud.net/privacy ↗</a></li>
              <li><a href="https://baxi.avocloud.net/terms/" class="accent-link" target="_blank" rel="noreferrer">baxi.avocloud.net/terms ↗</a></li>
            </ul>

            <h4 class="reg-h3">SkyFire</h4>
            <ul class="reg-list">
              <li>We reserve the right to discontinue our SkyFire service and shut down all associated servers. If we decide to discontinue this project, we will notify you in advance and provide sufficient time to back up your data.</li>
            </ul>
          </div>
        </section>

        <!-- Discord Related Rules -->
        <section id="drr" style="margin-bottom: 2.5rem;">
          <div class="section-label">DISCORD RELATED RULES</div>
          <div class="card">
            <span class="mk tl"></span><span class="mk br"></span>
            <h3>
              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"><path d="M21 15a2 2 0 0 1-2 2H7l-4 4V5a2 2 0 0 1 2-2h14a2 2 0 0 1 2 2z"/></svg>
              Discord Related Rules (DRR)
            </h3>
            <p style="font-family: var(--font-mono); font-size: 0.8rem; margin-bottom: 1rem;">Last update: 15.12.2024</p>

            <p>
              The following rules must be adhered to on our
              <a href="https://avocloud.net/discord/" class="accent-link" target="_blank" rel="noreferrer">Discord</a> server.
              Failure to comply may result in a temporary or permanent suspension. These rules also apply
              to our global chat operated by Baxi.
            </p>

            <h4 class="reg-h3">Peaceful Interaction</h4>
            <ul class="reg-list">
              <li>Treat all members with respect and kindness.</li>
              <li>No harassment, discrimination, or hate speech of any kind.</li>
              <li>Avoid personal attacks or inflammatory comments.</li>
            </ul>

            <h4 class="reg-h3">No Spamming</h4>
            <ul class="reg-list">
              <li>Spamming messages, images, or links is prohibited.</li>
              <li>Please refrain from excessively repeating the same message in a short time.</li>
              <li>Avoid mass tagging others without reason.</li>
            </ul>

            <h4 class="reg-h3">NSFW and Offensive Content</h4>
            <ul class="reg-list">
              <li>Explicit or NSFW content is strictly prohibited.</li>
              <li>No sharing of inappropriate or offensive material in any form.</li>
              <li>Respect everyone's boundaries and preferences.</li>
            </ul>

            <h4 class="reg-h3">No Self-Promotion or Advertising</h4>
            <ul class="reg-list">
              <li>Do not promote channels, servers, services or products without permission from the server team.</li>
              <li>Passing on referral links or advertising other servers is not permitted.</li>
            </ul>

            <h4 class="reg-h3">Respect Privacy</h4>
            <ul class="reg-list">
              <li>Do not share anyone's personal information without their consent.</li>
              <li>Respect others' privacy and do not engage in doxxing or any harmful behavior.</li>
            </ul>

            <h4 class="reg-h3">Follow Channel-Specific Guidelines</h4>
            <ul class="reg-list">
              <li>Each channel has a specific topic, so please keep messages relevant to the channel's purpose.</li>
              <li>If you're unsure about where to post, ask a mod for guidance.</li>
            </ul>

            <h4 class="reg-h3">Listen to Staff</h4>
            <ul class="reg-list">
              <li>Respect the decisions and instructions of server moderators and admins.</li>
              <li>If you have concerns about a decision, address it politely and privately with the staff.</li>
            </ul>

            <h4 class="reg-h3">No Cheating or Exploiting</h4>
            <ul class="reg-list">
              <li>Do not use cheats, hacks, or exploits that disrupt the server's activities.</li>
              <li>Engaging in unfair practices or cheating is grounds for a ban.</li>
            </ul>

            <h4 class="reg-h3">German or English only</h4>
            <ul class="reg-list">
              <li>Please use only English or German on our entire server, whether in voice or text channels.</li>
              <li>Let's keep the community fun and welcoming for everyone!</li>
            </ul>

            <h4 class="reg-h3">No Trolling or Disruption</h4>
            <ul class="reg-list">
              <li>Avoid trolling, disrupting conversations, or creating unnecessary chaos.</li>
              <li>Let's keep the community fun and welcoming for everyone!</li>
            </ul>

            <h4 class="reg-h3">Enforcement and Appeals</h4>
            <p>Our moderation team follows these guidelines:</p>
            <ul class="reg-list">
              <li>Minor infractions typically result in a warning.</li>
              <li>Repeated or severe violations may lead to temporary or permanent restrictions.</li>
              <li>You may appeal moderation decisions by contacting <a href="mailto:support@avocloud.net" class="accent-link">support@avocloud.net</a> with relevant details.</li>
              <li>Appeals will be reviewed by a team member not involved in the original decision.</li>
            </ul>
          </div>
        </section>

        <!-- Contact -->
        <section id="contact">
          <div class="section-label">CONTACT</div>
          <h2 class="headline" style="font-size: 1.75rem; margin-bottom: 2rem;">Get In Touch</h2>
          <div class="grid cols-3">
            <div class="card">
              <span class="mk tl"></span><span class="mk br"></span>
              <h3>
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"><path d="M21 15a2 2 0 0 1-2 2H7l-4 4V5a2 2 0 0 1 2-2h14a2 2 0 0 1 2 2z"/></svg>
                Discord Community
              </h3>
              <p>Join our community for support and updates:</p>
              <a href="https://avocloud.net/discord/" target="_blank" rel="noreferrer" class="accent-link">avocloud.net/discord ↗</a>
            </div>

            <div class="card">
              <span class="mk tl"></span><span class="mk br"></span>
              <h3>
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round">
                  <path d="M4 4h16c1.1 0 2 .9 2 2v12c0 1.1-.9 2-2 2H4c-1.1 0-2-.9-2-2V6c0-1.1.9-2 2-2z"/>
                  <polyline points="22,6 12,13 2,6"/>
                </svg>
                Support
              </h3>
              <p>For support of any kind:</p>
              <a href="mailto:support@avocloud.net" class="accent-link">support@avocloud.net ↗</a>
            </div>

            <div class="card">
              <span class="mk tl"></span><span class="mk br"></span>
              <h3>
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round">
                  <path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"/><polyline points="14 2 14 8 20 8"/>
                </svg>
                Legal &amp; Impressum
              </h3>
              <p>For legal inquiries:</p>
              <a href="/impressum" class="accent-link">Visit Impressum ↗</a>
            </div>
          </div>
        </section>
      </div>
    </main>
  </Shell>
</Layout>

<style>
  .reg-h3 {
    font-family: var(--font-mono);
    font-size: 0.85rem;
    text-transform: uppercase;
    letter-spacing: 0.03em;
    color: var(--coral);
    margin: 1.5rem 0 0.5rem;
  }
  .reg-list {
    color: var(--muted);
    font-size: 0.9rem;
    padding-left: 1.25rem;
    margin-bottom: 1rem;
    display: flex;
    flex-direction: column;
    gap: 0.35rem;
  }
</style>
