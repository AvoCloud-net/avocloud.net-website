---
import Layout from '@/layouts/Layout.astro';
import Shell from '@/components/Shell.tsx';
import PwGen from '@/components/PwGen.tsx';
---
<Layout
  title="Password Generator – Avocloud.net"
  description="Generate strong and secure passwords with Avocloud.net's free password generator – fast, customizable, and easy to use."
  canonical="https://avocloud.net/pwgen/"
  schema={false}
>
  <Shell client:load>
    <main class="section" id="pwgen">
      <div class="wrap" style="max-width: 640px;">
        <h2 class="headline">Generate your secure password</h2>
        <p style="color: var(--muted); margin-top: -1.5rem; margin-bottom: 2.5rem;">
          Strong, customizable passwords in seconds &ndash; fast, easy &amp; safe.
        </p>
        <PwGen client:load />
      </div>
    </main>
  </Shell>
</Layout>
