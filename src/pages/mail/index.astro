---
import Layout from '@/layouts/Layout.astro';
import Shell from '@/components/Shell.tsx';

const mailtoUrl = 'mailto:support@avocloud.net';
---
<Layout
  title="Redirecting to Support Mail – Avocloud.net"
  description="Send us an email to solve support requests quickly and easily."
  canonical="https://avocloud.net/mail/"
  schema={false}
  noindex={true}
>
  <Shell client:load>
    <section class="section" id="mail-redirect">
      <div class="wrap" style="max-width: 420px; text-align: center;">
        <div class="card">
          <span class="mk tl"></span><span class="mk br"></span>
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" class="redirect-spinner" style="width: 2.5rem; height: 2.5rem; color: var(--coral); margin: 0 auto 1rem;">
            <path d="M21 12a9 9 0 1 1-6.219-8.56"/>
          </svg>
          <h1 style="font-family: var(--font-brand); font-weight: 700; font-size: 1.25rem; margin-bottom: 0.5rem;">
            Opening Mail
          </h1>
          <p style="color: var(--muted); font-size: 0.9rem; margin-bottom: 1.5rem;">
            Your mail client will open automatically in a moment...
          </p>
          <a href={mailtoUrl} class="accent-link">Click here if nothing happens ↗</a>
        </div>
      </div>
    </section>
  </Shell>
</Layout>

<style>
  .redirect-spinner { animation: spin 1.2s linear infinite; }
  @keyframes spin { to { transform: rotate(360deg); } }
</style>

<script>
  setTimeout(() => {
    location.href = 'mailto:support@avocloud.net';
  }, 3000);
</script>
